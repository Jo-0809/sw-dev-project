# 이 파일을 .env 로 복사해서 값을 채운다. (.env는 git에 올리지 않는다. 키를 다른 파일·채팅에 붙여 넣지 않는다)

# ---- 조건 추출 (LLM) ----
# 쓸 제공자: gemini 또는 anthropic
LLM_PROVIDER=gemini
# API 키. 둘 다 비워 두면 예시 결과(사람이 작성) / 규칙 기반으로 추출한다.
#   Gemini 키: Google AI Studio  /  Anthropic 키: Claude Console (Claude Pro 구독과 별개, 사용량 요금)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# 모델 이름. 바꾸면 기존 LLM 녹화(recordings/llm)와 맞지 않는다 (녹화 열쇠에 모델 이름이 들어감)
# gemini-3.8-flash: Gemini API 폐기 일정 페이지가 새 프로젝트에 권장하는 모델, 종료일 미발표 (2026-11-14 확인)
#   2.5 모델은 '예전에 쓰던 사용자만' 쓸 수 있게 막혀 있어 새 키로는 안 될 수 있다
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-haiku-5-5
# auto: 녹화가 있으면 재생, 없으면 호출 후 녹화 / live: 항상 호출 / replay: 녹화만 (발표장)
LLM_MODE=auto

# ---- 시연 모드 ----
# 1: 시연 계정, 모의 게시판, 시연 초기화 버튼을 켠다
# 0: 모두 끈다 (시연 초기화는 DB 전체를 지우므로 실제로 쓸 때는 반드시 0)
DEMO_MODE=1
# 시연 계정. 비밀번호를 비워 두면 처음 실행할 때 무작위로 만들어 data/demo_account.txt 에 적고 실행 창에도 보여 준다.
# demo1234 같은 흔한 비밀번호는 브라우저가 '유출된 비밀번호'로 경고하니 쓰지 않는다. 실제로 쓰는 비밀번호도 넣지 않는다.
DEMO_ID=notchil-demo
DEMO_PASSWORD=

# ---- 학교 사이트 요청 ----
# replay: recordings/web 의 저장된 실제 응답 재생 (네트워크 안 씀)
# live:   실제 요청 / record: 실제 요청 + 응답 저장 (발표 전에 학교 네트워크에서)
FETCH_MODE=replay

# 수집 스케줄러 주기(분). 품질 시나리오 3순위의 환경 조건 30분.
COLLECT_INTERVAL_MIN=30
# 처음 등록한 출처에서 한 번에 가져올 최대 공지 수 (학교 서버 부하 제한)
COLLECT_MAX_NEW=10

# 시연용 '오늘' 날짜. 저장된 실제 공지(2026-10-11 저장)가 마감 전으로 보이게 2026-10-12 로 둔다.
# 비우면 실제 오늘 (그러면 실제 공지는 대부분 마감 지남 → 전체 보기의 '함께 보기'로 확인).
DEMO_TODAY=2026-10-12

HOST=127.0.0.1
PORT=8000
